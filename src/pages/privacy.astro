---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Privacy Policy';
const description =
  'How TradePulse handles information for visitors and customers of PulsePOS and related services. Placeholder policy—replace with legal review.';
---

<BaseLayout title={title} description={description} canonicalPath="/privacy">
  <article class="mx-auto max-w-3xl px-4 pb-24 pt-32 md:px-6 md:pt-36">
    <h1 class="text-4xl font-medium tracking-tight text-surface-900">Privacy Policy</h1>
    <p class="mt-4 text-muted">Last updated: April 5, 2026</p>
    <div class="mt-10 max-w-none text-[17px] leading-relaxed">
      <p class="text-muted">
        This page is a placeholder. Replace this content with a policy drafted for your jurisdictions, products, and data
        practices.
      </p>
      <h2 class="mt-10 text-2xl font-medium tracking-tight">Overview</h2>
      <p class="mt-3 text-muted">
        TradePulse is committed to protecting privacy for teams evaluating or using PulsePOS. When you replace this
        stub, describe what you collect, why, retention, subprocessors, and contact details for privacy requests.
      </p>
    </div>
  </article>
</BaseLayout>
