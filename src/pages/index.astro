---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import ProblemSolution from '@/components/sections/ProblemSolution.astro';
import Features from '@/components/sections/Features.astro';
import Trust from '@/components/sections/Trust.astro';
import Pricing from '@/components/sections/Pricing.astro';
import FinalCta from '@/components/sections/FinalCta.astro';

const title = 'NutaPOS - Cloud POS & management for modern businesses';
const description =
  'Run inventory, sales, bookkeeping, staff, and insights in one system. NutaPOS is a cloud POS system for Africa and Ghana businesses-management software with real-time stock alerts and enterprise-grade trust.';

const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'NutaPOS',
  url: site ? `${site}/` : undefined,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'GHS',
    description: 'Contact for Growth and Enterprise tiers',
  },
  description:
    'NutaPOS is a point-of-sale and inventory management system for businesses, with cloud storage, audit-friendly workflows, and role-based access.',
  provider: {
    '@type': 'Organization',
    name: 'NutaSolutions',
    url: site || undefined,
  },
};
---

<BaseLayout title={title} description={description} ogType="website">
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <Hero />
  <ProblemSolution />
  <Features />
  <Trust />
  <Pricing />
  <FinalCta />
</BaseLayout>
