---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import ProblemSolution from '@/components/sections/ProblemSolution.astro';
import Features from '@/components/sections/Features.astro';
import Partners from '@/components/sections/Partners.astro';
import Trust from '@/components/sections/Trust.astro';
import Pricing from '@/components/sections/Pricing.astro';
import FinalCta from '@/components/sections/FinalCta.astro';

const title = 'NutaPOS — Point of sale and shop management for Ghana';
const description =
  'Sell offline, track stock and expiry, take Mobile Money, and see your shop from your phone. NutaPOS is built for shops and wholesale businesses in Ghana.';

const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'NutaPOS',
  url: site ? `${site}/` : undefined,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'GHS',
    description: 'Free trial available; contact for Pro and Enterprise',
  },
  description:
    'NutaPOS is a point-of-sale and shop management system for Ghana, with offline selling, stock and expiry tracking, Mobile Money, and multi-branch support.',
  provider: {
    '@type': 'Organization',
    name: 'NutaSolutions',
    url: site || undefined,
  },
};
---

<BaseLayout title={title} description={description} ogType="website">
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <Hero />
  <ProblemSolution />
  <Features />
  <Partners />
  <Trust />
  <Pricing />
  <FinalCta />
</BaseLayout>
