---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'Terms of Service';
const description =
  'Terms governing use of TradePulse websites and PulsePOS. Placeholder terms—replace with legal review before production.';
---

<BaseLayout title={title} description={description} canonicalPath="/terms">
  <article class="mx-auto max-w-3xl px-4 pb-24 pt-32 md:px-6 md:pt-36">
    <h1 class="text-4xl font-medium tracking-tight text-surface-900">Terms of Service</h1>
    <p class="mt-4 text-muted">Last updated: April 5, 2026</p>
    <div class="mt-10 max-w-none text-[17px] leading-relaxed">
      <p class="text-muted">
        This page is a placeholder. Replace this content with terms appropriate for your entity, product, and regions.
      </p>
      <h2 class="mt-10 text-2xl font-medium tracking-tight">Agreement</h2>
      <p class="mt-3 text-muted">
        By accessing TradePulse websites or using PulsePOS, you agree to the final terms published here. This stub is not
        legal advice.
      </p>
    </div>
  </article>
</BaseLayout>
