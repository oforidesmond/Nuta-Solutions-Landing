---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'PulseWEB';
const description =
  'PulseWEB is on the roadmap—web experiences that complement PulsePOS. Subscribe for updates from TradePulse.';
---

<BaseLayout title={title} description={description} canonicalPath="/pulseweb">
  <section class="mx-auto max-w-3xl px-4 pb-24 pt-32 text-center md:px-6 md:pt-36">
    <p class="text-sm font-medium text-brand-600">Coming soon</p>
    <h1 class="mt-3 text-4xl font-medium tracking-tight text-surface-900">PulseWEB</h1>
    <p class="mx-auto mt-5 max-w-xl text-lg text-muted">
      A companion web experience for your retail stack—placeholders for now while we focus on PulsePOS excellence.
    </p>
    <a
      href="/#features"
      class="btn-secondary mt-10 inline-flex"
    >
      Explore PulsePOS features
    </a>
  </section>
</BaseLayout>
