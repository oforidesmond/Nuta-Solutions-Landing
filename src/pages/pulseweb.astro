---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'NutaWEB';
const description =
  'NutaWEB is on the roadmap—web experiences that complement NutaPOS. Subscribe for updates from NutaSolutions.';
---

<BaseLayout title={title} description={description} canonicalPath="/nutaweb">
  <section class="mx-auto max-w-3xl px-4 pb-24 pt-32 text-center md:px-6 md:pt-36">
    <p class="text-sm font-medium text-brand-600">Coming soon</p>
    <h1 class="mt-3 text-4xl font-medium tracking-tight text-surface-900">NutaWEB</h1>
    <p class="mx-auto mt-5 max-w-xl text-lg text-muted">
      A companion web experience for your business stack—placeholders for now while we focus on NutaPOS excellence.
    </p>
    <a
      href="/#features"
      class="btn-secondary mt-10 inline-flex"
    >
      Explore NutaPOS features
    </a>
  </section>
</BaseLayout>
