---
// Client-side only modal (no hydration framework).
const businessTypes = [
  'Retail',
  'Wholesale',
  'Retail/Wholesale',
  'Pharmacy',
  'Hospitality & Service',
  'Boutique',
  'Other',
];

const heardAbout = [
  'Google Search',
  'Word of Mouth / Referral',
  'Salesperson',
  'Facebook',
  'X / Twitter',
  'TikTok',
  'Snapchat',
  'Youtube',
];
---

<div
  id="tp-modal-overlay"
  class="fixed inset-0 z-[1000] hidden bg-black/40 backdrop-blur-[6px]"
  aria-hidden="true"
>
  <div
    class="mx-auto flex min-h-dvh w-full items-center justify-center px-4 py-10"
    role="presentation"
  >
    <div
      id="tp-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="tp-modal-title"
      class="glass relative w-full max-w-[740px] overflow-hidden rounded-[2rem]"
    >
      <div class="flex items-start justify-between gap-6 border-b border-surface-200/80 p-6">
        <div>
          <h2 id="tp-modal-title" class="text-xl font-medium tracking-tight text-surface-900">
            Start for free
          </h2>
          <p id="tp-modal-subtitle" class="mt-2 text-[14px] leading-relaxed text-muted">
            Two steps. Takes less than a minute. Then you’ll get a welcome email.
          </p>
        </div>
        <button
          type="button"
          class="rounded-full border border-surface-200/80 bg-white/70 px-3 py-2 text-sm font-medium text-surface-900 shadow-[var(--shadow-soft)] transition-all hover:bg-white"
          data-tp-close
          aria-label="Close"
        >
          Close
        </button>
      </div>

      <div class="p-6">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <button
              type="button"
              class="rounded-full px-4 py-2 text-sm font-medium transition-all"
              data-tp-mode="signup"
              aria-pressed="true"
            >
              Sign up
            </button>
            <button
              type="button"
              class="rounded-full border border-surface-200/80 bg-white/70 px-4 py-2 text-sm font-medium transition-all text-surface-900"
              data-tp-mode="signin"
              aria-pressed="false"
            >
              Sign in
            </button>
          </div>
          <p id="tp-inline-status" class="text-sm text-muted"></p>
        </div>

        <!-- SIGNUP (Step 1) -->
        <form id="tp-signup-step1" class="mt-8" autocomplete="on">
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-lg font-medium tracking-tight text-surface-900">Step 1: Account</h3>
            <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700 ring-1 ring-brand-100/80">
              1/2
            </span>
          </div>

          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            <label class="block">
              <span class="text-sm font-medium text-surface-900">Full name</span>
              <input
                name="name"
                type="text"
                required
                class="mt-2 w-full rounded-xl border border-surface-200/80 bg-white/80 px-4 py-3 text-[15px] outline-none transition focus:border-brand-300/80 focus:ring-2 focus:ring-brand-200/70"
                placeholder="e.g., Ama Mensah"
              />
              <span class="mt-1 block text-xs text-rose-700" data-err-for="name"></span>
            </label>

            <label class="block">
              <span class="text-sm font-medium text-surface-900">Email</span>
              <input
                name="email"
                type="email"
                required
                class="mt-2 w-full rounded-xl border border-surface-200/80 bg-white/80 px-4 py-3 text-[15px] outline-none transition focus:border-brand-300/80 focus:ring-2 focus:ring-brand-200/70"
                placeholder="you@company.com"
              />
              <span class="mt-1 block text-xs text-rose-700" data-err-for="email"></span>
            </label>

            <label class="block">
              <span class="text-sm font-medium text-surface-900">Password</span>
              <input
                name="password"
                type="password"
                required
                class="mt-2 w-full rounded-xl border border-surface-200/80 bg-white/80 px-4 py-3 text-[15px] outline-none transition focus:border-brand-300/80 focus:ring-2 focus:ring-brand-200/70"
                placeholder="At least 8 characters"
              />
              <span class="mt-1 block text-xs text-rose-700" data-err-for="password"></span>
            </label>

            <label class="block">
              <span class="text-sm font-medium text-surface-900">Confirm password</span>
              <input
                name="confirmPassword"
                type="password"
                required
                class="mt-2 w-full rounded-xl border border-surface-200/80 bg-white/80 px-4 py-3 text-[15px] outline-none transition focus:border-brand-300/80 focus:ring-2 focus:ring-brand-200/70"
                placeholder="Re-enter password"
              />
              <span class="mt-1 block text-xs text-rose-700" data-err-for="confirmPassword"></span>
            </label>

            <label class="block sm:col-span-2">
              <span class="text-sm font-medium text-surface-900">Phone number</span>
              <input
                name="phone"
                type="tel"
                required
                class="mt-2 w-full rounded-xl border border-surface-200/80 bg-white/80 px-4 py-3 text-[15px] outline-none transition focus:border-brand-300/80 focus:ring-2 focus:ring-brand-200/70"
                placeholder="e.g., +233 24 123 4567"
              />
              <span class="mt-1 block text-xs text-rose-700" data-err-for="phone"></span>
            </label>
          </div>

          <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:justify-end">
            <button type="button" class="btn-secondary justify-center" data-tp-close-step1>
              Cancel
            </button>
            <button type="submit" class="btn-primary justify-center">
              Continue
            </button>
          </div>
        </form>

        <!-- SIGNUP (Step 2) -->
        <form id="tp-signup-step2" class="mt-8 hidden" autocomplete="on">
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-lg font-medium tracking-tight text-surface-900">Step 2: Business</h3>
            <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700 ring-1 ring-brand-100/80">
              2/2
            </span>
          </div>

          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            <label class="block sm:col-span-2">
              <span class="text-sm font-medium text-surface-900">Business name</span>
              <input
                name="businessName"
                type="text"
                required
                class="mt-2 w-full rounded-xl border border-surface-200/80 bg-white/80 px-4 py-3 text-[15px] outline-none transition focus:border-brand-300/80 focus:ring-2 focus:ring-brand-200/70"
                placeholder="e.g., Nutamarket Ltd"
              />
              <span class="mt-1 block text-xs text-rose-700" data-err-for="businessName"></span>
            </label>

            <label class="block">
              <span class="text-sm font-medium text-surface-900">Business type</span>
              <select
                name="businessType"
                required
                class="mt-2 w-full rounded-xl border border-surface-200/80 bg-white/80 px-4 py-3 text-[15px] outline-none transition focus:border-brand-300/80 focus:ring-2 focus:ring-brand-200/70"
              >
                <option value="" selected disabled>Choose one</option>
                {
                  businessTypes.map((bt) => <option value={bt}>{bt}</option>)
                }
              </select>
              <span class="mt-1 block text-xs text-rose-700" data-err-for="businessType"></span>
            </label>

            <label class="block">
              <span class="text-sm font-medium text-surface-900">Business location</span>
              <input
                name="businessLocation"
                type="text"
                required
                class="mt-2 w-full rounded-xl border border-surface-200/80 bg-white/80 px-4 py-3 text-[15px] outline-none transition focus:border-brand-300/80 focus:ring-2 focus:ring-brand-200/70"
                placeholder="e.g., Accra, Ghana"
              />
              <span class="mt-1 block text-xs text-rose-700" data-err-for="businessLocation"></span>
            </label>

            <label class="block">
              <span class="text-sm font-medium text-surface-900">How many branches?</span>
              <input
                name="branches"
                type="number"
                min="1"
                required
                class="mt-2 w-full rounded-xl border border-surface-200/80 bg-white/80 px-4 py-3 text-[15px] outline-none transition focus:border-brand-300/80 focus:ring-2 focus:ring-brand-200/70"
              />
              <span class="mt-1 block text-xs text-rose-700" data-err-for="branches"></span>
            </label>

            <label class="block">
              <span class="text-sm font-medium text-surface-900">How did you hear about us?</span>
              <select
                name="heardAbout"
                required
                class="mt-2 w-full rounded-xl border border-surface-200/80 bg-white/80 px-4 py-3 text-[15px] outline-none transition focus:border-brand-300/80 focus:ring-2 focus:ring-brand-200/70"
              >
                <option value="" selected disabled>Choose one</option>
                {
                  heardAbout.map((h) => <option value={h}>{h}</option>)
                }
              </select>
              <span class="mt-1 block text-xs text-rose-700" data-err-for="heardAbout"></span>
            </label>
          </div>

          <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:justify-end">
            <button type="button" class="btn-secondary justify-center" data-tp-back-to-step1>
              Back
            </button>
            <button type="submit" class="btn-primary justify-center">
              Submit
            </button>
          </div>
        </form>

        <!-- SIGNIN -->
        <form id="tp-signin-form" class="mt-8 hidden" autocomplete="on">
          <div class="flex items-center justify-between gap-4">
            <h3 class="text-lg font-medium tracking-tight text-surface-900">Sign in</h3>
            <span class="rounded-full bg-surface-100 px-3 py-1 text-xs font-medium text-surface-900 ring-1 ring-surface-200/80">
              Prototype
            </span>
          </div>

          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            <label class="block sm:col-span-2">
              <span class="text-sm font-medium text-surface-900">Email</span>
              <input
                name="email"
                type="email"
                required
                class="mt-2 w-full rounded-xl border border-surface-200/80 bg-white/80 px-4 py-3 text-[15px] outline-none transition focus:border-brand-300/80 focus:ring-2 focus:ring-brand-200/70"
                placeholder="you@company.com"
              />
              <span class="mt-1 block text-xs text-rose-700" data-err-for="signinEmail"></span>
            </label>

            <label class="block sm:col-span-2">
              <span class="text-sm font-medium text-surface-900">Password</span>
              <input
                name="password"
                type="password"
                required
                class="mt-2 w-full rounded-xl border border-surface-200/80 bg-white/80 px-4 py-3 text-[15px] outline-none transition focus:border-brand-300/80 focus:ring-2 focus:ring-brand-200/70"
                placeholder="Your password"
              />
              <span class="mt-1 block text-xs text-rose-700" data-err-for="signinPassword"></span>
            </label>
          </div>

          <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:justify-end">
            <button type="button" class="btn-secondary justify-center" data-tp-close-signin>
              Cancel
            </button>
            <button type="submit" class="btn-primary justify-center">
              Sign in
            </button>
          </div>
        </form>

        <div id="tp-modal-success" class="mt-8 hidden">
          <div class="rounded-[1.5rem] border border-brand-200/80 bg-brand-50 p-5">
            <p class="text-sm font-medium text-brand-700">Welcome to NutaSolutions</p>
            <p id="tp-success-message" class="mt-2 text-[15px] leading-relaxed text-surface-900">
              We’ve created your account. Check your email for the next steps.
            </p>
            <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:justify-end">
              <button type="button" class="btn-secondary justify-center" data-tp-close-success>
                Close
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const overlay = document.getElementById('tp-modal-overlay');
    if (!overlay) return;

    const step1 = document.getElementById('tp-signup-step1');
    const step2 = document.getElementById('tp-signup-step2');
    const signin = document.getElementById('tp-signin-form');
    const successBox = document.getElementById('tp-modal-success');

    const title = document.getElementById('tp-modal-title');
    const subtitle = document.getElementById('tp-modal-subtitle');
    const inlineStatus = document.getElementById('tp-inline-status');

    let signupState = {};

    function setMode(mode) {
      successBox.classList.add('hidden');
      if (mode === 'signup') {
        title.textContent = 'Start for free';
        if (subtitle) {
          subtitle.textContent = 'Two steps. Takes less than a minute. Then you’ll get a welcome email.';
          subtitle.classList.remove('hidden');
        }
        step1.classList.remove('hidden');
        step2.classList.add('hidden');
        signin.classList.add('hidden');
        signupState = {};
        inlineStatus.textContent = '';
        syncModeButtons(mode);
      } else {
        title.textContent = 'Sign in';
        if (subtitle) {
          subtitle.textContent = '';
          subtitle.classList.add('hidden');
        }
        step1.classList.add('hidden');
        step2.classList.add('hidden');
        signin.classList.remove('hidden');
        inlineStatus.textContent = '';
        syncModeButtons(mode);
      }
      clearAllErrors();
    }

    function syncModeButtons(mode) {
      const modeButtons = overlay.querySelectorAll('[data-tp-mode]');
      modeButtons.forEach((b) => {
        const pressed = b.getAttribute('data-tp-mode') === mode;
        b.setAttribute('aria-pressed', pressed ? 'true' : 'false');
        b.className = pressed
          ? 'rounded-full bg-brand-50 px-4 py-2 text-sm font-medium text-brand-700 ring-1 ring-brand-100/80'
          : 'rounded-full border border-surface-200/80 bg-white/70 px-4 py-2 text-sm font-medium transition-all text-surface-900';
      });
    }

    function open(mode) {
      overlay.classList.remove('hidden');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      setMode(mode);
      // Focus first relevant input
      const firstInput = overlay.querySelector('input,select,button');
      if (firstInput) firstInput.focus();
    }

    function close() {
      overlay.classList.add('hidden');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      inlineStatus.textContent = '';
      successBox.classList.add('hidden');
      clearAllErrors();
    }

    function clearAllErrors() {
      const errs = overlay.querySelectorAll('[data-err-for]');
      errs.forEach((el) => (el.textContent = ''));
    }

    function setError(key, message) {
      const el = overlay.querySelector('[data-err-for="' + key + '"]');
      if (el) el.textContent = message;
    }

    function isValidEmail(v) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(v).trim());
    }

    function isValidPhone(v) {
      const raw = String(v || '').trim();
      if (raw.length < 7) return false;
      // Basic permissive check: digits, spaces, +, (, ), -
      if (!/^[0-9+()\s-]+$/.test(raw)) return false;
      const digits = raw.replace(/\D/g, '');
      return digits.length >= 7 && digits.length <= 15;
    }

    overlay.addEventListener('click', (e) => {
      const closeBtn = e.target && e.target.closest && e.target.closest('[data-tp-close]');
      if (closeBtn) close();

      const closeBg = e.target === overlay;
      if (closeBg) close();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !overlay.classList.contains('hidden')) close();
    });

    document.addEventListener('click', (e) => {
      const opener = e.target && e.target.closest && e.target.closest('[data-tp-open]');
      if (!opener) return;
      const mode = opener.getAttribute('data-tp-open') || 'signup';
      e.preventDefault();
      open(mode);
    });

    overlay.querySelector('[data-tp-close-step1]')?.addEventListener('click', close);
    overlay.querySelector('[data-tp-close-signin]')?.addEventListener('click', close);
    overlay.querySelector('[data-tp-close-success]')?.addEventListener('click', close);

    overlay.querySelector('[data-tp-back-to-step1]')?.addEventListener('click', function () {
      clearAllErrors();
      step1.classList.remove('hidden');
      step2.classList.add('hidden');
    });

    // Step 1 submission
    step1.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearAllErrors();
      inlineStatus.textContent = '';

      const form = e.target;
      const name = form.elements.name.value.trim();
      const email = form.elements.email.value.trim();
      const password = form.elements.password.value;
      const confirmPassword = form.elements.confirmPassword.value;
      const phone = form.elements.phone.value.trim();

      let ok = true;
      if (!name || name.length < 2) {
        setError('name', 'Please enter your full name.');
        ok = false;
      }
      if (!isValidEmail(email)) {
        setError('email', 'Please enter a valid email.');
        ok = false;
      }
      if (!password || password.length < 8) {
        setError('password', 'Password must be at least 8 characters.');
        ok = false;
      }
      if (confirmPassword !== password) {
        setError('confirmPassword', 'Passwords do not match.');
        ok = false;
      }
      if (!isValidPhone(phone)) {
        setError('phone', 'Please enter a valid phone number.');
        ok = false;
      }

      if (!ok) return;

      signupState = { name, email, password, phone };
      step1.classList.add('hidden');
      step2.classList.remove('hidden');
      // Focus step2 first field
      const first = step2.querySelector('input,select');
      if (first) first.focus();
    });

    // Step 2 submission
    step2.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearAllErrors();
      inlineStatus.textContent = '';

      const form = e.target;
      const businessName = form.elements.businessName.value.trim();
      const businessType = form.elements.businessType.value;
      const businessLocation = form.elements.businessLocation.value.trim();
      const branches = form.elements.branches.value;
      const heardAbout = form.elements.heardAbout.value;

      let ok = true;
      if (!businessName) {
        setError('businessName', 'Business name is required.');
        ok = false;
      }
      if (!businessType) {
        setError('businessType', 'Please choose a business type.');
        ok = false;
      }
      if (!businessLocation) {
        setError('businessLocation', 'Business location is required.');
        ok = false;
      }
      const branchesNum = Number(branches);
      if (!Number.isFinite(branchesNum) || branchesNum < 1 || branchesNum > 999) {
        setError('branches', 'Branches must be between 1 and 999.');
        ok = false;
      }
      if (!heardAbout) {
        setError('heardAbout', 'Please select how you heard about us.');
        ok = false;
      }
      if (!ok) return;

      inlineStatus.textContent = 'Submitting...';

      const payload = {
        ...signupState,
        businessName,
        businessType,
        businessLocation,
        branches: branchesNum,
        heardAbout,
        signupSource: 'landing',
      };

      try {
        const res = await fetch('/api/signup', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          inlineStatus.textContent = data?.message || 'Signup failed. Please try again.';
          return;
        }
        const status = data?.emailStatus;
        const msg =
          status === 'sent'
            ? 'You’re all set. Welcome email sent.'
            : status === 'failed'
              ? 'You’re all set. We saved your details, but email sending failed.'
              : 'You’re all set. Welcome email will be sent soon.';

        document.getElementById('tp-success-message').textContent = msg;
        inlineStatus.textContent = '';
        successBox.classList.remove('hidden');
      } catch (err) {
        inlineStatus.textContent = 'Network error. Please try again.';
      }
    });

    // Sign-in submission
    signin.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearAllErrors();
      inlineStatus.textContent = '';

      const form = e.target;
      const email = form.elements.email.value.trim();
      const password = form.elements.password.value;

      let ok = true;
      if (!isValidEmail(email)) {
        setError('signinEmail', 'Please enter a valid email.');
        ok = false;
      }
      if (!password) {
        setError('signinPassword', 'Please enter your password.');
        ok = false;
      }
      if (!ok) return;

      inlineStatus.textContent = 'Signing in...';

      try {
        const res = await fetch('/api/signin', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          inlineStatus.textContent = data?.message || 'Sign in failed.';
          return;
        }
        inlineStatus.textContent = 'Signed in (prototype).';
        successBox.classList.remove('hidden');
        document.getElementById('tp-success-message').textContent =
          'Welcome back. In production, this will create a real session.';
      } catch (err) {
        inlineStatus.textContent = 'Network error. Please try again.';
      }
    });

    // Mode switching buttons
    overlay.querySelectorAll('[data-tp-mode]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-tp-mode') || 'signup';
        setMode(mode);
      });
    });
  })();
</script>
