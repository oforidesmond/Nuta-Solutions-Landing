---
const items = [
  {
    title: 'Secure cloud infrastructure',
    desc: 'Encryption-minded architecture with resilient hosting so your data stays available when stores need it.',
  },
  {
    title: 'Audit logging',
    desc: 'A clear trail of critical actions—so teams can review what changed, when, and why.',
  },
  {
    title: 'Role-based access',
    desc: 'Owner and staff permissions that match how real teams work day to day.',
  },
  {
    title: 'Reliability you can plan around',
    desc: 'Designed for dependable uptime and calm operations—because checkout should never feel fragile.',
  },
];
---

<section id="trust" class="scroll-mt-28 px-4 py-20 md:px-6 md:py-28" aria-labelledby="trust-heading">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl" data-reveal>
      <h2 id="trust-heading" class="section-title">Why businesses trust NutaPOS</h2>
      <p class="section-sub">
        Enterprise expectations, small-business speed. NutaPOS pairs a cloud POS system with controls that help owners
        sleep better—ideal for management software used across locations.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {
        items.map((item, i) => (
          <article
            class="rounded-[1.75rem] border border-surface-200/80 bg-white/70 p-8 shadow-[var(--shadow-soft)] backdrop-blur-sm transition-all duration-200 hover:border-brand-200/50 hover:shadow-[var(--shadow-float)]"
            data-reveal
            style={`transition-delay: ${i * 40}ms`}
          >
            <h3 class="text-xl font-medium tracking-tight text-surface-900">{item.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-muted">{item.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
