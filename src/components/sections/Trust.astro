---
const items = [
  {
    title: 'Your data stays in the cloud',
    desc: 'Sales and stock sync to the cloud and back up from staff phones, so you do not lose records when a phone breaks.',
  },
  {
    title: 'A clear activity log',
    desc: 'See who changed what and when. Useful when you need to check mistakes, disputes, or missing stock.',
  },
  {
    title: 'Owner, manager, cashier roles',
    desc: 'Give each person only the access they need. Cap discounts and lock sensitive actions to owners.',
  },
  {
    title: 'Built for real shop conditions',
    desc: 'Weak network? Keep selling offline. When the connection returns, everything catches up automatically.',
  },
];
---

<section id="trust" class="scroll-mt-28 px-4 py-20 md:px-6 md:py-28" aria-labelledby="trust-heading">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl" data-reveal>
      <h2 id="trust-heading" class="section-title">Why shop owners trust NutaPOS</h2>
      <p class="section-sub">
        You keep control of your money, your stock, and your staff — whether you have one shop or many.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {
        items.map((item, i) => (
          <article
            class="rounded-[1.75rem] border border-surface-200/80 bg-white/70 p-8 shadow-[var(--shadow-soft)] backdrop-blur-sm transition-all duration-200 hover:border-brand-200/50 hover:shadow-[var(--shadow-float)]"
            data-reveal
            style={`transition-delay: ${i * 40}ms`}
          >
            <h3 class="text-xl font-medium tracking-tight text-surface-900">{item.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-muted">{item.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
