---
import { mailtoHref } from '@/lib/contact';

const tiers = [
  {
    name: 'Trial',
    price: 'Start free',
    blurb: 'Try NutaPOS with one shop. See sales, stock, and staff on the phone app and Management Hub.',
    cta: 'Start free trial',
    featured: false,
    action: 'signup' as const,
    note: '1 shop',
  },
  {
    name: 'Pro',
    price: 'Contact us',
    blurb: 'For growing businesses — up to three shops, more staff, and tighter control of stock and discounts.',
    cta: 'Talk to sales',
    featured: true,
    action: 'mailto' as const,
    mailtoSubject: 'Sales inquiry — Pro',
    note: 'Up to 3 shops',
  },
  {
    name: 'Enterprise',
    price: 'Contact us',
    blurb: 'For larger networks — unlimited shops, custom setup, and support that matches how you operate.',
    cta: 'Contact us',
    featured: false,
    action: 'mailto' as const,
    mailtoSubject: 'Sales inquiry — Enterprise',
    note: 'Unlimited shops',
  },
];
---

<section id="pricing" class="scroll-mt-28 px-4 py-20 md:px-6 md:py-28" aria-labelledby="pricing-heading">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl" data-reveal>
      <h2 id="pricing-heading" class="section-title">Plans that grow with your shops</h2>
      <p class="section-sub">
        Start with one shop on trial. Move to Pro or Enterprise when you need more branches. We will help you pick what
        fits.
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-3">
      {
        tiers.map((t, i) => (
          <article
            class:list={[
              'relative flex flex-col rounded-[1.75rem] border p-8 transition-all duration-200',
              t.featured
                ? 'border-brand-200/80 bg-white shadow-[var(--shadow-float)] ring-1 ring-brand-100/60'
                : 'border-surface-200/80 bg-white/80 shadow-[var(--shadow-soft)] hover:border-brand-200/40',
            ]}
            data-reveal
            style={`transition-delay: ${i * 45}ms`}
          >
            {t.featured && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-brand-600 px-3 py-1 text-xs font-medium text-white">
                Popular
              </span>
            )}
            <h3 class="text-lg font-medium tracking-tight text-surface-900">{t.name}</h3>
            <p class="mt-1 text-sm text-muted">{t.note}</p>
            <p class="mt-4 text-3xl font-medium tracking-tight text-surface-900">{t.price}</p>
            <p class="mt-4 flex-1 text-[15px] leading-relaxed text-muted">{t.blurb}</p>
            {t.action === 'signup' ? (
              <button
                type="button"
                data-tp-open="signup"
                class:list={[
                  'mt-8 inline-flex w-full items-center justify-center rounded-full px-5 py-3 text-[15px] font-medium transition-all duration-200',
                  t.featured ? 'btn-primary' : 'btn-secondary',
                ]}
              >
                {t.cta}
              </button>
            ) : (
              <a
                href={mailtoHref(t.mailtoSubject)}
                class:list={[
                  'mt-8 inline-flex w-full items-center justify-center rounded-full px-5 py-3 text-[15px] font-medium transition-all duration-200 no-underline',
                  t.featured ? 'btn-primary' : 'btn-secondary',
                ]}
              >
                {t.cta}
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
