---
import FeatureIcon from '@/components/FeatureIcon.astro';

const features = [
  {
    title: 'Sell when internet is down',
    desc: 'Staff keep selling on the phone app offline. When the network comes back, sales upload on their own.',
    icon: 'wifi',
  },
  {
    title: 'See the shop from your phone',
    desc: 'Open the Management Hub anytime. Check sales, stock, and money without calling the shop.',
    icon: 'phone',
  },
  {
    title: 'Stock, expiry, and batches',
    desc: 'Know what is left, which batch will expire soon, and get warned before goods go bad.',
    icon: 'calendar',
  },
  {
    title: 'Mobile Money and more',
    desc: 'Record cash, Mobile Money, card, bank transfer, or mixed payments on every sale.',
    icon: 'wallet',
  },
  {
    title: 'Many shops, one account',
    desc: 'Add branches, see each shop’s stock and sales, set different prices, and move stock between shops.',
    icon: 'branches',
  },
  {
    title: 'Carton to piece, tracked',
    desc: 'Break a carton into singles and keep stock correct — whether you sell by piece or by pack.',
    icon: 'box',
  },
  {
    title: 'Staff you can control',
    desc: 'Owner, manager, and cashier roles. Cap discounts, limit who can void sales, and see who did what.',
    icon: 'users',
  },
  {
    title: 'Alerts that matter',
    desc: 'Get told about low stock, expiry, returns, and unusual activity — so you can act before you lose money.',
    icon: 'bell',
  },
] as const;
---

<section id="features" class="scroll-mt-28 px-4 py-20 md:px-6 md:py-28" aria-labelledby="features-heading">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl" data-reveal>
      <h2 id="features-heading" class="section-title">What NutaPOS does for your business</h2>
      <p class="section-sub">
        Built for provision shops, pharmacies, cosmetics, hardware, boutiques, and wholesale — anyone ready to leave
        notebooks behind.
      </p>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((f, i) => (
          <article class="card-feature" data-reveal style={`transition-delay: ${i * 35}ms`}>
            <div class="flex h-11 w-11 items-center justify-center rounded-2xl bg-brand-50 text-brand-700 ring-1 ring-brand-100/80">
              <FeatureIcon name={f.icon} />
            </div>
            <h3 class="mt-5 text-lg font-medium tracking-tight text-surface-900">{f.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">{f.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
