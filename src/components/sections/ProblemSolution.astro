---
const problems = [
  'Writing sales in notebooks and losing track',
  'Stock finishes before you know',
  'Goods expire and you lose money',
  'Not knowing what staff sold when you are away',
  'Internet goes off and selling stops',
];
---

<section class="px-4 py-20 md:px-6 md:py-28" aria-labelledby="problem-heading">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-14 lg:grid-cols-2 lg:gap-20">
      <div data-reveal>
        <h2 id="problem-heading" class="section-title">Running a shop should not feel this hard</h2>
        <p class="section-sub">
          Many owners still guess what is left on the shelf, chase staff for numbers, and only find problems after money
          is gone.
        </p>
        <ul class="mt-10 list-none space-y-4">
          {
            problems.map((p) => (
              <li class="flex gap-3 text-[17px] leading-snug text-surface-900">
                <span
                  class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-600"
                  aria-hidden="true"
                />
                {p}
              </li>
            ))
          }
        </ul>
      </div>
      <div data-reveal class="flex flex-col justify-center">
        <div class="glass rounded-[2rem] p-8 md:p-10">
          <p class="text-sm font-medium uppercase tracking-wider text-brand-600">How NutaPOS helps</p>
          <h3 class="mt-3 text-2xl font-medium tracking-tight text-surface-900 md:text-3xl">
            One system for sales, stock, and money
          </h3>
          <p class="mt-5 text-lg leading-relaxed text-muted">
            Your cashiers sell on the phone app — even offline. When the network returns, sales upload by themselves. You
            open the Management Hub and see what sold, what is left, and how much came in — without calling the shop.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
