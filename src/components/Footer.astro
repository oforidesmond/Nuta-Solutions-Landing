---
import LogoMark from '@/components/LogoMark.astro';

const year = new Date().getFullYear();
const signupHref = import.meta.env.PUBLIC_SIGNUP_URL ?? '#signup';
---

<footer class="border-t border-surface-200/80 bg-white/60 py-16 backdrop-blur-sm">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <a href="/" class="inline-flex items-center gap-2.5 text-surface-900 no-underline">
          <LogoMark class="h-8 w-8" variant="dark" />
          <span class="text-[17px] font-medium tracking-tight">NutaSolutions</span>
        </a>
        <p class="mt-4 max-w-md text-[15px] leading-relaxed text-muted">
          Software built for clarity—point of sale, inventory, and insights in one calm experience.
        </p>
      </div>
      <div>
        <p class="text-xs font-medium uppercase tracking-wider text-muted">Products</p>
        <ul class="mt-4 list-none space-y-3">
          <li>
            <a href="/#features" class="text-[15px] text-surface-900 hover:text-brand-600">NutaPOS</a>
          </li>
          <li>
            <a href="/nutaweb" class="text-[15px] text-surface-900 hover:text-brand-600">NutaWEB</a>
          </li>
        </ul>
      </div>
      <div>
        <p class="text-xs font-medium uppercase tracking-wider text-muted">Company</p>
        <ul class="mt-4 list-none space-y-3">
          <li>
            <a href="mailto:hello@nutasolutions.com" class="text-[15px] text-surface-900 hover:text-brand-600">
              hello@nutasolutions.com
            </a>
          </li>
          <li>
            <a href="/privacy" class="text-[15px] text-surface-900 hover:text-brand-600">Privacy</a>
          </li>
          <li>
            <a href="/terms" class="text-[15px] text-surface-900 hover:text-brand-600">Terms</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="mt-12 flex flex-col gap-4 border-t border-surface-200/80 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-muted">© {year} NutaSolutions. All rights reserved.</p>
      <a href="#" data-tp-open="signup" class="text-sm font-medium text-brand-600 hover:text-brand-700"> Start for free → </a>
    </div>
  </div>
</footer>
